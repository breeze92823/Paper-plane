# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Colyseus server (../Paper-plane-backend), one URL per Bloxity Legion channel.
# `npm run dev` uses _DEV (default ws://localhost:2567); `npm run build` (production) uses _MAIN.
# `npm run build:dev` is mode "development", so it also uses _DEV. Leave _MAIN empty until prod is deployed.
# With no server reachable the game just runs single-player.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=

# Optional starting progress (whole numbers; bad values fall back to 0).
VITE_INITIAL_POWER=
VITE_INITIAL_WINS=
VITE_INITIAL_REBIRTHS=
# true = rebirth automatically the moment the level cap is reached.
VITE_AUTO_REBIRTH=false
# Length of a daily-rewards "day" in ms for a guest's (local) calendar; default 86400000.
# A signed-in player's comes from the server (Paper-plane-backend's DAILY_DAY_MS).
VITE_DAILY_DAY_MS=

# Multiplayer server (../Paper-plane-backend). DEV is used by `npm run dev` (falls back
# to a local server on ws://localhost:2567); MAIN is used by production builds. Leave
# MAIN empty until the backend is deployed: the game then just plays solo.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
